# Copy to ".env" and edit. Everything is optional - the defaults work out of the box.
# ".env" is ignored by Git. Never put secrets in a committed file.

# Default model id (see: python tts.py --list-models)
LOCAL_TTS_MODEL=chatterbox-turbo

# auto | cuda | cuda:0 | cpu
LOCAL_TTS_DEVICE=auto

# Default language code (used by multilingual models)
LOCAL_TTS_LANGUAGE=en

# Folders (relative to the project root or absolute). Weights are downloaded into MODELS_DIR.
LOCAL_TTS_MODELS_DIR=models
LOCAL_TTS_VOICES_DIR=voices
LOCAL_TTS_OUTPUT_DIR=output
LOCAL_TTS_CACHE_DIR=.cache

# Hugging Face Hub behaviour (optional):
# HF_HUB_OFFLINE=1          # never touch the network once the weights are cached
# HF_HOME=/path/to/cache    # use an existing Hugging Face cache instead of models/
